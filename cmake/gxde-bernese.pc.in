prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/gxde-bernese-qt@BERNESE_QT_MAJOR_VERSION@

Name: gxde-bernese-qt@BERNESE_QT_MAJOR_VERSION@
Description: GXDE compatibility helpers implemented with public Qt APIs
Version: @PROJECT_VERSION@
Requires: Qt@BERNESE_QT_MAJOR_VERSION@Core Qt@BERNESE_QT_MAJOR_VERSION@Gui Qt@BERNESE_QT_MAJOR_VERSION@Widgets x11 xcb
Libs.private: -lX11 -lxcb -lxcb-randr
Libs: -L${libdir} -lgxde-bernese-qt@BERNESE_QT_MAJOR_VERSION@
Cflags: -I${includedir}
