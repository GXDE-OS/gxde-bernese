        <briefdescription>
<para>Resolve a Qt-style high-DPI asset path. </para>
        </briefdescription>
        <detaileddescription>
<para>Prefers the smallest adequate scale, otherwise the largest available. Honors QT_HIGHDPI_DISABLE_2X_IMAGE_LOADING.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>path</parametername>
</parameternamelist>
<parameterdescription>
<para>Original asset path, possibly already carrying a scale suffix. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>scale</parametername>
</parameternamelist>
<parameterdescription>
<para>Requested device scale. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>source_scale</parametername>
</parameternamelist>
<parameterdescription>
<para>Non-null output receiving the selected scale, or 1. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Selected asset path, or the original path if no alternative is found. </para>
</simplesect>
</para>
        </detaileddescription>
