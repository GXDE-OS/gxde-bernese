      <memberdef kind="function" id="window__effects_8cc_1ae053d8f79d50444d6fcf205611dd4340" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>bool</type>
        <definition>BERNESE_EXPORT bool bernese::window_effects::SetWindowRadius</definition>
        <argsstring>(QWindow *window, int radius)</argsstring>
        <name>SetWindowRadius</name>
        <qualifiedname>bernese::window_effects::SetWindowRadius</qualifiedname>
        <param>
          <type>QWindow *</type>
          <declname>window</declname>
        </param>
        <param>
          <type>int</type>
          <declname>radius</declname>
        </param>
        <briefdescription>
<para>Set the corner radius the Wayland compositor draws for a window. </para>
        </briefdescription>
        <detaileddescription>
<para>Replaces the dde_shell window radius that DBlurEffectWidget sets on Wayland. Treeland reads 0 as &quot;use the default&quot;, so use 1 for a square window.</para>
<para>Call on the GUI thread after the window is shown, and again after each show, like SetBlurBehind(). <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>window</parametername>
</parameternamelist>
<parameterdescription>
<para>Top-level window, may be null. Not owned. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>radius</parametername>
</parameternamelist>
<parameterdescription>
<para>Corner radius in logical pixels. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>True when the radius was sent. False off Wayland, for a null or hidden window, or when the compositor has no dde_shell. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
