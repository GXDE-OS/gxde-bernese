        <type>QRect</type>
        <definition>BERNESE_EXPORT QRect bernese::window_utils::ToNativePixels</definition>
        <argsstring>(const QRect &amp;rect, const QPoint &amp;screen_origin, qreal scale)</argsstring>
        <name>ToNativePixels</name>
        <qualifiedname>bernese::window_utils::ToNativePixels</qualifiedname>
        <param>
          <type>const QRect &amp;</type>
          <declname>rect</declname>
        </param>
        <param>
          <type>const QPoint &amp;</type>
          <declname>screen_origin</declname>
        </param>
        <param>
          <type>qreal</type>
          <declname>scale</declname>
        </param>
        <briefdescription>
<para>Converts a rectangle from logical pixels to native pixels. </para>
        </briefdescription>
        <detaileddescription>
<para>Scales the offset of <computeroutput>rect</computeroutput> from <computeroutput>screen_origin</computeroutput> by <computeroutput>scale</computeroutput>. Needed for high-DPI and multi-monitor setups.</para>
<para><simplesect kind="note"><para>This is for X11. </para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>rect</parametername>
</parameternamelist>
<parameterdescription>
<para>Rectangle in logical pixels. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>screen_origin</parametername>
</parameternamelist>
<parameterdescription>
<para>Screen origin (same in logical and native coords). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>scale</parametername>
</parameternamelist>
<parameterdescription>
<para>Device pixel ratio, must be finite and &gt; 0. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Rectangle in native pixels, or an empty QRect if <computeroutput>scale</computeroutput> is invalid. </para>
</simplesect>
</para>
        </detaileddescription>
